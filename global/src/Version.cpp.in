/**
 * @file
 *
 * This is a template file for generating the Version.cpp source on the fly.
 * Content of the form ${example} is replaced by suitable values.
 *
 * Most of the methods below return values that are fixed for the life of a cmake
 * configuration (the Chaste version number, compiler information, and so on): these are
 * substituted directly into this file by cmake, exactly as before.
 *
 * A few methods instead return information that can change between two builds with no
 * reconfigure in between: the build timestamp, git revision and modified flag, and the
 * checked-out project versions. Rather than being substituted here, these are read at
 * runtime from plain files under a provenance/ directory, refreshed on every build by the
 * generate_provenance target in global/CMakeLists.txt. Embedding build-time-variable content
 * directly in this file would make it, and hence chaste_global, recompile and relink on
 * every build; reading it from a file that nothing is compiled from avoids that entirely.
 */

#include "Version.hpp"
#include "ChasteBuildRoot.hpp"
#include <cstdlib>
#include <fstream>
#include <sstream>
#include <ctime>
#include <climits>
#include <utility>
#include <vector>

namespace
{

/**
 * @return the provenance directory for this build: the build tree location if it exists (the
 * common case, covering dev machines and CI alike), else the installed location if it exists
 * (a genuinely installed, out-of-tree Chaste), else an unset FileFinder if neither is present.
 *
 * In the build tree, each configuration has its own subdirectory, named by ChasteBuildDirName():
 * "." for a single-config generator, or the configuration name for a multi-config one.
 */
FileFinder FindProvenanceDir()
{
    FileFinder build_tree_dir("global/provenance/" + ChasteBuildDirName(), RelativeTo::ChasteBuildRoot);
    if (build_tree_dir.IsDir())
    {
        return build_tree_dir;
    }
    FileFinder install_dir(std::string(ChasteInstallRootDir()) + "lib/chaste/provenance", RelativeTo::Absolute);
    if (install_dir.IsDir())
    {
        return install_dir;
    }
    return FileFinder();
}

/**
 * @return the provenance directory, resolved once per process.
 */
const FileFinder& rGetProvenanceDir()
{
    static const FileFinder provenance_dir = FindProvenanceDir();
    return provenance_dir;
}

/**
 * @return the contents of the named file inside rDir, with any trailing whitespace (such as a
 * final newline) removed, or rDefault if rDir is unset or the file cannot be found.
 *
 * @param rDir  the directory to look in
 * @param rName  the leaf name of the file to read
 * @param rDefault  what to return if the file cannot be found
 */
std::string ReadFileIn(const FileFinder& rDir, const std::string& rName, const std::string& rDefault)
{
    if (!rDir.IsPathSet())
    {
        return rDefault;
    }
    FileFinder file(rName, rDir);
    if (!file.IsFile())
    {
        return rDefault;
    }
    std::ifstream in(file.GetAbsolutePath().c_str());
    std::ostringstream contents;
    contents << in.rdbuf();
    std::string result = contents.str();
    boost::algorithm::trim_right(result);
    return result;
}

/**
 * @return the contents of the named file within the provenance directory, read once per
 * process and cached by the caller, or rDefault if it cannot be found.
 *
 * @param rName  the leaf name of the file to read
 * @param rDefault  what to return if the file cannot be found
 */
std::string ReadProvenanceFile(const std::string& rName, const std::string& rDefault)
{
    return ReadFileIn(rGetProvenanceDir(), rName, rDefault);
}

/** A project's git/svn revision and whether it has uncommitted changes, keyed by project name. */
typedef std::pair<std::map<std::string, std::string>, std::map<std::string, std::string> > ProjectInfo;

/**
 * @return the version and modified-flag maps for every checked-out project. The
 * subdirectories of provenance/projects/ are discovered with FileFinder::FindMatches, rather
 * than from any separate manifest, so this is the only place that needs to know how the
 * per-project files are laid out. Every project found gets an entry in both maps, so callers
 * can look up one map using the other's keys.
 */
ProjectInfo LoadProjectInfo()
{
    ProjectInfo info;
    const FileFinder& r_provenance_dir = rGetProvenanceDir();
    if (r_provenance_dir.IsPathSet())
    {
        FileFinder projects_dir("projects", r_provenance_dir);
        if (projects_dir.IsDir())
        {
            for (const FileFinder& r_project_dir : projects_dir.FindMatches("*"))
            {
                if (r_project_dir.IsDir())
                {
                    const std::string name = r_project_dir.GetLeafName();
                    info.first[name] = ReadFileIn(r_project_dir, "version", "Unknown");
                    info.second[name] = ReadFileIn(r_project_dir, "modified", "False");
                }
            }
        }
    }
    return info;
}

/**
 * @return the project information, read once per process.
 */
const ProjectInfo& rGetProjectInfo()
{
    static const ProjectInfo info = LoadProjectInfo();
    return info;
}

} // anonymous namespace

std::string ChasteBuildInfo::GetLicenceText()
{
    static const std::string licence = ReadProvenanceFile("licence.txt", "Licence text unavailable.");
    return licence;
}

const char* ChasteBuildInfo::GetRootDir()
{
    return "${Chaste_SOURCE_DIR}";
}

std::string ChasteBuildInfo::GetVersionString()
{
    std::stringstream version;
    version << GetMajorReleaseNumber() << "." << GetMinorReleaseNumber()
            << "." << std::hex << GetRevisionNumber() << std::dec;
    return version.str();
}

unsigned ChasteBuildInfo::GetMajorReleaseNumber()
{
    return ${Chaste_VERSION_MAJOR}u;
}

unsigned ChasteBuildInfo::GetMinorReleaseNumber()
{
    return ${Chaste_VERSION_MINOR}u;
}

unsigned long long ChasteBuildInfo::GetRevisionNumber()
{
    static const unsigned long long revision = strtoull(ReadProvenanceFile("git_revision", "0").c_str(), nullptr, 16);
    return revision;
}

bool ChasteBuildInfo::IsWorkingCopyModified()
{
    static const bool modified = (ReadProvenanceFile("git_modified", "false") == "true");
    return modified;
}

const char* ChasteBuildInfo::GetBuildTime()
{
    static const std::string build_time = ReadProvenanceFile("timestamp", "unknown");
    return build_time.c_str();
}

const char* ChasteBuildInfo::GetCurrentTime()
{
    // Get local time; the format's %z gives its offset from UTC
    time_t rawtime;
    time(&rawtime);
    struct tm* p_timeinfo = localtime(&rawtime);
    // Convert to string
    const unsigned bufsize = ${time_size};
    static char buffer[bufsize];
    strftime(buffer, bufsize, "${time_format}", p_timeinfo);
    return buffer;
}

const char* ChasteBuildInfo::GetBuilderUnameInfo()
{
    return "${CMAKE_SYSTEM_NAME}";
}

const char* ChasteBuildInfo::GetBuildInformation()
{
    return "${Chaste_BUILD_TYPE}";
}

const char* ChasteBuildInfo::GetCompilerType()
{
    return "${CMAKE_CXX_COMPILER}";
}

const char* ChasteBuildInfo::GetCompilerVersion()
{
    return "${CMAKE_CXX_COMPILER_VERSION}";
}

const char* ChasteBuildInfo::GetCompilerFlags()
{
    return "${ALL_CXX_FLAGS}";
}

const std::map<std::string, std::string>& ChasteBuildInfo::rGetProjectVersions()
{
    return rGetProjectInfo().first;
}

const std::map<std::string, std::string>& ChasteBuildInfo::rGetIfProjectsModified()
{
    return rGetProjectInfo().second;
}

std::string ChasteBuildInfo::GetProvenanceString()
{
    std::stringstream prov;
    prov << "Created by Chaste version " << GetVersionString();
    if (IsWorkingCopyModified())
    {
        prov << " (with uncommitted modifications)";
    }
    prov << " on " << GetCurrentTime() << ".  ";
    prov << "Chaste was built on " << GetBuildTime()
         << " by machine (uname) '" << GetBuilderUnameInfo()
         << "' using settings: " << GetBuildInformation();
    const std::map<std::string, std::string>& r_project_versions = rGetProjectVersions();
    for (std::map<std::string, std::string>::const_iterator iter = r_project_versions.begin();
         iter != r_project_versions.end();
         ++iter)
    {
        if (iter == r_project_versions.begin())
        {
            prov << ".  Checked-out project versions: ";
        }
        else
        {
            prov << "; ";
        }
        prov << iter->first << "=" << iter->second;
    }
    prov << "." << std::endl;
    return prov.str();
}

std::string ChasteBuildInfo::GetChasteCodegenVersion()
{
    return "${Chaste_CODEGEN_VERSION}";
}

const char* ChasteBuildInfo::GetXsdVersion()
{
    return "${xsd_version}";
}
